# linguist gets confused by PIR files, and thinks they make up a lot of our source!
*.pir linguist-detectable=false
# Large HTML files inside 'notes' are dominating our repoistory language
# estimate.
notes/**/*.html linguist-documentation
doc/* linguist-documentation
# don't do any newline conversion (taken from tasty-golden/silver hackage advice)
# covers both plain *.golden files and the *.golden.<type> family
# (*.golden.eval, *.golden.uplc, *.golden.pir, ...), which otherwise get
# CRLF-converted on Windows checkout and mismatch the LF test output.
*.golden	-text
*.golden.*	-text
